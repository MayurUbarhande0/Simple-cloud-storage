# ===============================================================================
# Simple Cloud Storage - Environment Template Configuration
# Copy this file to '.env' and update the values before running the app.
# ===============================================================================

# ----------------------------------------------------------------------------
# Required by the gateway authentication layer
# ----------------------------------------------------------------------------
# Must match the value used by token generation / validation.
SECRET_KEY=change-me

# ----------------------------------------------------------------------------
# Required by the gateway database layer
# ----------------------------------------------------------------------------
# Path to the SQLite database file used by the gateway.
DB_URL=./identifier.sqlite

# ----------------------------------------------------------------------------
# Optional runtime/network settings
# ----------------------------------------------------------------------------
# TCP storage node address used by the older storage-node prototype.
LISTEN_ADDR=:8081

# Public HTTP gateway port (frontend points here for API calls).
GATEWAY_HTTP_PORT=:8080

# Storage node address used by the gateway when talking to the backend.
STORAGE_IP=127.0.0.1:8081