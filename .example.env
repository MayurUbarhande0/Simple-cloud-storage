# ==============================================================================
# Simple Cloud Storage - Environment Template Configuration
# Copy this file to '.env' and fill out with your parameters before booting.
# ==============================================================================

# 🔐 Cryptographic Credentials
# JWT_SECRET: Secret key used to sign and verify client auth tokens (32+ chars recommended)
# ENCRYPTION_KEY: Secret key used to encrypt the inner TCP handshake payload (Must be exactly 32 bytes for AES-256)
# AUTH_KEY: The plaintext gateway identity token that the storage node expects after decryption
JWT_SECRET=abcdefghijklmnopqrstuvwxyz123456
ENCRYPTION_KEY=abcdefghijklmnopqrstuvwxyz123456
AUTH_KEY=my-secure-auth-token-24

# 🌐 Network Connectivity Endpoints
# GATEWAY_HTTP_PORT: Local bind port for the public HTTP reverse-proxy API entrypoint
# STORAGE_IP: Target network address where the TCP Storage Node socket listener is reachable
GATEWAY_HTTP_PORT=:8080
STORAGE_IP=127.0.0.1:8081